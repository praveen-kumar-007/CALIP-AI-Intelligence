# ==============================================================================
# CALIP - COGNITIVE ATOMIC LEGAL INTELLIGENCE PLATFORM
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="CALIP Legal Case & Document Intelligence Platform"
APP_ENV=production
DEBUG=false
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS="*"

# Canonical & Upstream URLs
CANONICAL_URL=https://longtailcases.com
LONGTAIL_BASE_URL=https://longtailcases.com
SCRAPER_USER_AGENT="CALIP-Legal-Intelligence/1.0 (Research Platform)"
SCRAPER_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# 2. DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
# SQLite default; for PostgreSQL with pgvector in production, use:
# DATABASE_URL=postgresql://user:password@localhost:5432/calip_db
DATABASE_URL=sqlite:///./data/calip.db

# ------------------------------------------------------------------------------
# 3. DIRECTORIES & DATA STORAGE (Relative to project root or absolute paths)
# ------------------------------------------------------------------------------
DATA_DIR=data
DOWNLOADS_DIR=data/downloads
INCOMING_DIR=data/incoming
OCR_STORAGE_DIR=data/ocr_extracted
CATALOG_CACHE_PATH=data/longtail_catalog_tree.json
STATIC_DIR=app/static

# ------------------------------------------------------------------------------
# 4. AUTO-SYNC & INCOMING DROPZONE WORKER
# ------------------------------------------------------------------------------
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_SECONDS=1800
INCOMING_POLL_INTERVAL_SECONDS=5

# ------------------------------------------------------------------------------
# 5. HIGH-LEVEL OCR & LAYOUT EXTRACTION PIPELINE
# ------------------------------------------------------------------------------
ENABLE_WINDOWS_OCR=true
# Optional: Path to custom tesseract binary if installed
TESSERACT_CMD=""
# Optional: Custom OCR command (e.g., "python my_ocr.py {input_image} {page_number}")
MY_OCR_COMMAND=""
OCR_CONFIDENCE_THRESHOLD=0.60
OCR_LANG=eng

# ------------------------------------------------------------------------------
# 6. VECTOR EMBEDDINGS & SEMANTIC SEARCH
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=auto
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# ------------------------------------------------------------------------------
# 7. PRODUCTION & LOCAL LLM INFERENCE (GROQ / NVIDIA / GEMINI / OLLAMA)
# ------------------------------------------------------------------------------
# Provider options: nvidia, groq, gemini, ollama, extractive, auto
LLM_PROVIDER=nvidia

# NVIDIA NIM (build.nvidia.com)
NVIDIA_API_KEY="your_nvidia_api_key_here"
NVIDIA_MODEL=mistralai/mistral-nemotron

# Groq Cloud Ultra-Fast LPUs (console.groq.com)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini (aistudio.google.com)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL=gemini-2.0-flash

# Local Ollama Inference (developer setup)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GENERATE_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen3:8b

# RAG & Generation Parameters
RAG_TEMPERATURE=0.1
RAG_TOP_K=4
RAG_TIMEOUT_SECONDS=30

# Cloud & Serverless deployment flag
SERVERLESS=false
